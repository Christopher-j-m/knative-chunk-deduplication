  "overlap_expectations": {
    "high": "Python functions sharing python:3.14-slim base + ML CPU functions sharing TF/PyTorch runtime layers",
    "medium": "Node functions sharing node:26-slim base + Java/Spring Boot functions sharing JRE base (~300 MB)",
    "low": "Go/Rust functions with static binaries and independent base images",
    "minimal": "Production inference servers built by different companies => no shared layers"
  },
  "coverage_scenarios": [
    {
      "name": "same-runtime-burst",
      "scope": null,
      "description": "All Python functions arrive first, then Node, then others",
