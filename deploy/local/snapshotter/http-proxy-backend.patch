+// DumpHTTPProxyConfigV2 writes the nydusd version 2 JSON translation of a FUSE
+// daemon configuration whose storage backend is the local http proxy. nydusd
+// only accepts the http-proxy backend in the version 2 format, while the rest
+// of the snapshotter keeps reading the version 1 file.
+func DumpHTTPProxyConfigV2(c *FuseDaemonConfig, path string) error {
+	prefetch := map[string]interface{}{
+		"enable":       c.FSPrefetch.Enable,
+		"threads":      c.FSPrefetch.ThreadsCount,
+		"batch_size":   c.FSPrefetch.MergingSize,
+		"prefetch_all": c.FSPrefetch.PrefetchAll,
+	}
+	rafs := map[string]interface{}{
+		"mode":          c.Mode,
+		"validate":      c.DigestValidate,
+		"enable_xattr":  c.EnableXattr,
+		"iostats_files": c.IOStatsFiles,
+		"prefetch":      prefetch,
+	}
+	if c.AmplifyIo != nil {
+		rafs["batch_size"] = *c.AmplifyIo
+	}
+
+	v2 := map[string]interface{}{
+		"version": 2,
+		"backend": map[string]interface{}{
+			"type": "http-proxy",
+			// the root path makes nydusd request /<blob-id>, which the chunk
+			// proxy needs to know which blob is being asked for
+			"http-proxy": map[string]interface{}{
+				"addr": c.Device.Backend.Config.Addr,
+				"path": "/",
+			},
+		},
+		"cache": map[string]interface{}{
+			"type":      c.Device.Cache.CacheType,
+			"filecache": map[string]interface{}{"work_dir": c.Device.Cache.Config.WorkDir},
+		},
+		"rafs": rafs,
+	}
+
+	b, err := json.Marshal(v2)
+	if err != nil {
+		return errors.Wrapf(err, "marshal v2 config")
+	}
+	return os.WriteFile(path, b, 0600)
+}
